# Primary local application — no credentials required.
# Keep this file free of secrets. Put local values in .env (ignored by Git).
APP_DB_PATH=data/runtime/weather_app.db

# true disables live forecast/catalogue retrieval and uses honest unavailable/cache states.
POLYMARKET_OFFLINE_ONLY=false

# scripts/start.py uses environment variables for optional ports (default 3000 / 8000).
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# BACKEND_URL=http://127.0.0.1:8000
# APP_ORIGIN=http://127.0.0.1:3000
# NEXT_DIST_DIR=.next

# Toast / Monzo / Xero / Companies House are visual demos; no credentials needed.
# Monitoring is opt-in through Settings and runs only while the API is running.

# Optional legacy Streamlit/Gemini reference only. Primary analysis is deterministic.
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
SQLITE_DB_PATH=data/runtime/app_state.db
