# Server-side Gemini configuration (never expose to browser)
# Set locally in .env (which is excluded from Git via .gitignore)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

# Optional Vertex AI configuration (if using Google Cloud ADC instead of API key)
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Optional runtime overrides
SQLITE_DB_PATH=data/runtime/app_state.db
POLYMARKET_OFFLINE_ONLY=false
