# Copy to .env.local (gitignored) and fill in your own keys. Never commit .env.local.
# No keys at all? Run `PUBHEDGE_OFFLINE=1 scripts/dev.sh`: cached data, template narration, no live calls.

# Gemini (agents and rationale). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Companies House public data API (company profile and officers). Free: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_KEY=

# Met Office Weather DataHub, site-specific forecast (live mode only). Free tier: https://datahub.metoffice.gov.uk/
METOFFICE_DATAHUB_KEY=

# Stripe TEST MODE only (sk_test_... / pk_test_...). Live keys are refused. https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# No key needed: postcodes.io, Open-Meteo, Polymarket public read API, openfootball, Wikipedia, HMRC.

# Optional settings (defaults shown)
# PUBHEDGE_OFFLINE=0                      # 1 = no live API or model calls
# PUBHEDGE_SPEND_CAP_USD=8                # stop live model calls past this Gemini spend
# PUBHEDGE_MODEL_FAST=gemini-3.8-flash    # tool-calling agents
# PUBHEDGE_MODEL_REASONING=gemini-4-argon # hedge rationale
# PUBHEDGE_MONITOR_MINUTES=               # set to re-run the monitor on a timer
# PUBHEDGE_DB=services/agents/pubhedge.db # SQLite audit log and proposals
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Deployment only (see docs/DEPLOY.md). Leave unset locally.
# API service (Cloud Run):
# PUBHEDGE_ACCESS_KEY=                    # long random string; the API then refuses calls without it
# PUBHEDGE_APP_ORIGIN=https://your-app.vercel.app   # the deployed app's origin, for CORS
# Front end (Vercel):
# NEXT_PUBLIC_API_URL=https://pubhedge-agents-xxxx.run.app
# NEXT_PUBLIC_PUBHEDGE_ACCESS_KEY=        # the same value as PUBHEDGE_ACCESS_KEY
# SITE_PASSWORD=                          # turns on the password gate for every page
# SITE_USER=pubhedge
